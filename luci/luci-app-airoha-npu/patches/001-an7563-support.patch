 . /lib/functions.sh
 
+airoha_eth_bound() {
+	local d e
+	for d in /sys/bus/platform/drivers/airoha_eth /sys/bus/platform/drivers/airoha-eth; do
+		[ -d "$d" ] || continue
+		for e in "$d"/*; do
+			[ -L "$e" ] && [ "${e##*/}" != "module" ] && return 0
+		done
+	done
+	return 1
+}
+
+soc_reg_ok() {
+	case "$1" in
+		0x1fb50104|\
+		0x1fb50604|0x1fb50608|0x1fb50648|0x1fb5064c|\
+		0x1fb51604|0x1fb51608|0x1fb51648|0x1fb5164c|\
+		0x1fb50580|0x1fb50590|0x1fb50594|0x1fb505a0|0x1fb505a4|\
+		0x1fb51580|0x1fb51590|0x1fb51594|0x1fb515a0|0x1fb515a4|\
+		0x1fa202ac|0x1fa202b8) return 0 ;;
+	esac
+	local a=$(($1))
+	[ $((a & 3)) -eq 0 ] || return 1
+	[ "$a" -ge $((0x1fb50120)) ] && [ "$a" -le $((0x1fb50148)) ] && return 0
+	[ "$a" -ge $((0x1fb50150)) ] && [ "$a" -le $((0x1fb50178)) ] && return 0
+	return 1
+}
+
+soc_rd() {
+	local v
+	[ "$ETH_BOUND" = "1" ] && soc_reg_ok "$1" || { echo 0; return 1; }
+	v=$(devmem "$1" 2>/dev/null)
+	echo $((${v:-0}))
+}
+
+read_pll() {
+	pll_freq=0
+	pll_valid=false
+	command -v devmem > /dev/null 2>&1 || return
+	local pcw pd
+	pcw=$(soc_rd 0x1fa202ac) || return
+	pd=$(soc_rd 0x1fa202b8) || return
+	pcw=$(( (pcw >> 24) & 0xFF ))
+	pd=$(( (pd >> 18) & 7 ))
+	[ "$pcw" -gt 0 ] || return
+	case "$pd" in
+		0) pll_freq=$((pcw * 50)); pll_valid=true ;;
+		1) pll_freq=$((pcw * 25)); pll_valid=true ;;
+	esac
+}
+
+npu_fw_path() {
+	local n rel f
+	for n in /proc/device-tree/soc/npu@* /proc/device-tree/npu@*; do
+		[ -f "$n/firmware-name" ] || continue
+		rel=$(tr '\0' '\n' < "$n/firmware-name" 2>/dev/null | grep -m1 "rv32")
+		[ -n "$rel" ] && [ -f "/lib/firmware/$rel" ] && { echo "/lib/firmware/$rel"; return; }
+	done
+	for f in /lib/firmware/airoha/an7563_npu_rv32.bin \
+		 /lib/firmware/airoha/*npu_rv32.bin; do
+		[ -f "$f" ] && { echo "$f"; return; }
+	done
+}
+
+ETH_BOUND=0
+airoha_eth_bound && ETH_BOUND=1
